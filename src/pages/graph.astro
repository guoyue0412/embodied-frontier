---
import SiteLayout from "../layouts/SiteLayout.astro";
import RelationshipList from "../components/static/RelationshipList.astro";
import { getKnowledgeGraph } from "../../lib/graph";

const graph = getKnowledgeGraph();
---
<SiteLayout title="知识图谱" description="浏览论文、模型与数据集之间由 Markdown 显式声明的关系。">
  <main id="main-content">
    <header class="page-intro page-shell">
      <span class="eyebrow">KNOWLEDGE RELATIONS</span>
      <h1>从孤立条目，<br />回到研究关系。</h1>
      <p>{graph.nodes.length} 个节点、{graph.edges.length} 条显式关系；拒绝从关键词共现自动臆测连接。</p>
    </header>
    <div class="page-section page-shell">
      <section class="graph-loader" aria-labelledby="graph-visual-title" data-graph={JSON.stringify(graph)}>
        <div><span class="eyebrow">OPTIONAL VISUAL LAYER</span><h2 id="graph-visual-title">轻量关系图</h2><p>默认不加载可视层，完整知识关系已在下方清单中呈现。</p></div>
        <button class="button button--primary" type="button" disabled title="静态发布版本使用下方键盘关系清单">加载关系图 <span aria-hidden="true">→</span></button>
      </section>
      <RelationshipList graph={graph} />
    </div>
  </main>
</SiteLayout>
