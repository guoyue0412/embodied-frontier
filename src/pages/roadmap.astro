---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../lib/site-path.mjs";

const [roadmapEntries, paperEntries] = await Promise.all([getCollection("roadmap"), getCollection("papers")]);
const roadmap = roadmapEntries.toSorted((a, b) => a.data.order - b.data.order);
const papers = new Map(paperEntries.map((paper) => [paper.data.slug, paper.data]));
---
<SiteLayout title="研究路线" description="从基础坐标、核心系统到前沿问题的具身智能学习与研究路线。">
  <main id="main-content">
    <header class="page-intro page-shell">
      <span class="eyebrow">RESEARCH ROADMAP</span>
      <h1>学习路线的终点，<br />是能设计验证实验。</h1>
      <p>每一阶段都明确目标与输出。阅读只是输入，真实完成信号来自代码、运行、指标和可解释的失败案例。</p>
    </header>
    <div class="page-section page-shell roadmap-full">
      {roadmap.map((stage) => <section class="roadmap-stage">
        <div class="roadmap-stage__number">{String(stage.data.order).padStart(2, "0")}</div>
        <div>
          <span class="roadmap-stage__meta">{stage.data.label} · {stage.data.duration}</span>
          <h2>{stage.data.title}</h2>
          <p>{stage.data.summary}</p>
          <div class="roadmap-columns">
            <div><h3>目标</h3><ul>{stage.data.goals.map((goal) => <li>{goal}</li>)}</ul></div>
            <div><h3>完成信号</h3><ul>{stage.data.outputs.map((output) => <li>{output}</li>)}</ul></div>
          </div>
          <div class="tag-list" aria-label="推荐阅读">
            {stage.data.reading.map((slug) => {
              const paper = papers.get(slug);
              return paper ? <a href={withBase(`/papers/${slug}/`)}>{paper.title} ↗</a> : null;
            })}
          </div>
        </div>
      </section>)}
    </div>
  </main>
</SiteLayout>
