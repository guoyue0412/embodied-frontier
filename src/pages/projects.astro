---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectCard from "../components/static/ProjectCard.astro";

const projects = (await getCollection("projects")).toSorted((a, b) => b.data.updated.localeCompare(a.data.updated));
---
<SiteLayout title="项目现场" description="具身智能评测、世界模型和论文雷达项目的证据、状态与下一步。">
  <main id="main-content">
    <header class="page-intro page-shell">
      <span class="eyebrow">ACTIVE RESEARCH</span>
      <h1>让项目状态，<br />落在证据层级上。</h1>
      <p>“已经配置”“正在运行”和“完成验证”不是同一件事。项目页分别记录问题、已有证据与下一步。</p>
    </header>
    <div class="page-section page-shell"><div class="project-grid">{projects.map((project) => <ProjectCard project={project.data} />)}</div></div>
  </main>
</SiteLayout>
