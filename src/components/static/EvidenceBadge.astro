---
interface Props {
  status: "verified" | "self-reported" | "unverified";
}

const labels = {
  verified: "已核验",
  "self-reported": "作者自评",
  unverified: "待核",
} as const;

const { status } = Astro.props;
---
<span class={`evidence evidence--${status}`} data-status={status}>
  <span class="evidence__dot" aria-hidden="true"></span>
  {labels[status]}
</span>
