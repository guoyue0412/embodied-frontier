---
import { withBase } from "../../lib/site-path.mjs";

const navigation = [
  { path: "/papers/", label: "论文" },
  { path: "/models/", label: "模型" },
  { path: "/datasets/", label: "数据" },
  { path: "/graph/", label: "图谱" },
  { path: "/projects/", label: "项目" },
  { path: "/roadmap/", label: "路线" },
  { path: "/about/", label: "关于" },
];
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href={withBase("/")} aria-label="具身前沿首页">
      <span class="wordmark__mark" aria-hidden="true">EF</span>
      <span>
        <strong>具身前沿</strong>
        <small>EMBODIED FRONTIER</small>
      </span>
    </a>
    <nav aria-label="主导航">
      {navigation.map((item) => <a href={withBase(item.path)}>{item.label}</a>)}
    </nav>
  </div>
</header>
