---
import { withBase } from "../../lib/site-path.mjs";

interface RailItem {
  id: string;
  code: string;
  label: string;
  path: string;
}

interface Props {
  items: RailItem[];
  current?: string;
}

const { items, current = "atlas" } = Astro.props;
---
<nav class="atlas-rail" aria-label="Atlas chapters" data-atlas-rail>
  <span class="atlas-rail__label">INDEX / 00—05</span>
  <ol>
    {items.map((item) => <li class:list={{ "is-current": item.id === current }}>
      <a href={withBase(item.path)} aria-current={item.id === current ? "page" : undefined}>
        <span>{item.code}</span><strong>{item.label}</strong>
      </a>
    </li>)}
  </ol>
</nav>
